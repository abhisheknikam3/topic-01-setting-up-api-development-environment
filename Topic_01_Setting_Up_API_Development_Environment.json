        "jsCode": "// Validate and transform JSON output logs\nconst items = $input.all();\nconst users = items.map(item => item.json);\n\nconst validatedUsers = users.map(user => {\n  const hasRequiredFields = Boolean(user.id && user.name && user.email && user.company);\n  return {\n    userId: user.id,\n    fullName: user.name,\n    username: user.username,\n    emailAddress: user.email,\n    city: user.address?.city || \"N/A\",\n    companyName: user.company?.name || \"N/A\",\n    isSchemaValid: hasRequiredFields\n  };\n});\n\nconst allValid = validatedUsers.every(u => u.isSchemaValid);\n\nreturn [\n  {\n    json: {\n      status: \"API_ENVIRONMENT_VALIDATED_SUCCESSFULLY\",\n      endpointQueried: \"https://jsonplaceholder.typicode.com/users\",\n      httpMethod: \"GET\",\n      totalRecordsReturned: users.length,\n      allRecordsValid: allValid,\n      environmentInfo: {\n        runtime: \"n8n Visual Workflow Engine\",\n        targetSandbox: \"JSONPlaceholder REST API\",\n        httpStatus: 200,\n        validationTimestamp: new Date().toISOString()\n      },\n      sampleUserProfiles: validatedUsers.slice(0, 3)\n    }\n  }\n];"
      },
